# Copy to .env.local with `pnpm env:local`. Blank values fall back to the
# defaults in src/lib/env/server.ts.

# Public origin of this site: canonical URLs, sitemap, Open Graph.
SITE_URL=http://localhost:3100

# Release identifier, sent as the x-app-version header and in /health/*.
APP_VERSION=dev

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# index | noindex, read at runtime. Stage sets noindex: robots.txt disallows
# everything and pages say noindex. The image is the same for stage and prod.
ROBOTS=index

# The APIs this server calls (in the cluster: http://<api>.prod.svc). For a
# local run point them at running services, or at `node e2e/mock-backend.mjs`
# (all four on http://127.0.0.1:3190, sign-in code 123456).
ID_API_URL=http://127.0.0.1:3190
WALLET_API_URL=http://127.0.0.1:3190
PAY_API_URL=http://127.0.0.1:3190
NOTIFICATIONS_API_URL=http://127.0.0.1:3190

# Key of the sealed session cookie, at least 32 characters, the same on every
# replica. Local only: generate one with `openssl rand -base64 32`.
SESSION_SECRET=

# Other origins a form may end on (CSP form-action), space-separated: the sites
# that sign in here (their /auth/callback) and the payment provider's checkout.
FORM_ACTION_ORIGINS=http://localhost:3000
